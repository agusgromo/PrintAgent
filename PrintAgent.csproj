<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-PrintAgent-e4666342-860c-440b-a26b-2db174b2530a</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;Downloads/**;Workers/Jobs/**;Logs/**</DefaultItemExcludes>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">true</SelfContained>
    <OutputType Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
